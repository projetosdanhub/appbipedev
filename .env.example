NODE_ENV=development
APP_ENV=local
APP_NAME=BipeSend
PUBLIC_DOMAIN=bipesend.com.br
PUBLIC_DOMAIN_ALIAS=bipesend.com
PUBLIC_BASE_URL=https://www.localhost:3443
APP_URL=https://app.localhost:3443
TENANT_APP_URL=https://app.localhost:3443
SUPERADMIN_APP_URL=https://admin.localhost:3443
API_URL=https://api.localhost:3443
HOOKS_URL=https://hooks.localhost:3443
INTERNAL_API_URL=http://127.0.0.1:4000
HTTPS_ENFORCE=true
LOCAL_HTTPS_PORT=3443
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=https://www.localhost:3443,https://app.localhost:3443,https://admin.localhost:3443

DATABASE_URL=postgresql://bipesend:bipesend_dev@localhost:5432/bipesend
REDIS_URL=redis://localhost:6379

AUTH_SESSION_SECRET=replace_with_32_bytes_or_more
DATA_ENCRYPTION_KEY=replace_with_a_secret_manager_value
WEBHOOK_SIGNING_SECRET=replace_with_a_secret_manager_value

MAIL_FROM=no-reply@localhost.test
SMTP_HOST=localhost
SMTP_PORT=1025

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=bipesend-local
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio_dev_only

NGROK_PUBLIC_URL=https://replace-me.ngrok.app

# Nunca expor estas variaveis em apps web.
OPENAI_API_KEY=server_only
GOOGLE_AI_API_KEY=server_only
STRIPE_CLIENT_ID=server_only
STRIPE_CLIENT_SECRET=server_only
MERCADOPAGO_CLIENT_ID=server_only
MERCADOPAGO_CLIENT_SECRET=server_only
