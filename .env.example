NODE_ENV=development
APP_ENV=local
APP_NAME=BipeSend
PUBLIC_DOMAIN=bipesend.com.br
PUBLIC_DOMAIN_ALIAS=bipesend.com
PUBLIC_BASE_URL=https://www.localhost:3443
APP_URL=https://app.localhost:3443
TENANT_APP_URL=https://app.localhost:3443
SUPERADMIN_APP_URL=https://admin.localhost:3443
API_URL=https://api.localhost:3443
HOOKS_URL=https://hooks.localhost:3443
INTERNAL_API_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
HTTPS_ENFORCE=true
LOCAL_HTTPS_PORT=3443
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=https://www.localhost:3443,https://app.localhost:3443,https://admin.localhost:3443

DATABASE_URL=postgresql://bipesend:bipesend_dev@localhost:5432/bipesend
REDIS_URL=redis://localhost:6379

AUTH_SESSION_SECRET=replace_with_32_bytes_or_more
DATA_ENCRYPTION_KEY=replace_with_a_secret_manager_value
WEBHOOK_SIGNING_SECRET=replace_with_a_secret_manager_value

MAIL_FROM="no-reply@bipesend.com.br"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Exemplo Hostinger/Titan/cPanel:
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="seu-email@bipesend.com.br"
# SMTP_PASS="sua_senha"
# Exemplo Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="resend"
# SMTP_PASS="re_sua_chave_aqui"

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=bipesend-local
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio_dev_only

NGROK_PUBLIC_URL=https://replace-me.ngrok.app

# AI Service (Python / Gemini / OpenAI)
AI_SERVICE_URL=http://127.0.0.1:5005
OPENAI_API_KEY=server_only
GOOGLE_AI_API_KEY=server_only
GEMINI_API_KEY=server_only
STRIPE_CLIENT_ID=server_only
STRIPE_CLIENT_SECRET=server_only
MERCADOPAGO_CLIENT_ID=server_only
MERCADOPAGO_CLIENT_SECRET=server_only

# Separate random values, generated locally; never commit actual secrets.
AUTH_SECRET=replace_with_32_bytes_or_more
SUPERADMIN_AUTH_SECRET=replace_with_a_different_random_secret
INTERNAL_API_KEY=replace_with_32_bytes_or_more
NEXT_PUBLIC_APP_URL=https://app.localhost:3443
NEXT_PUBLIC_SUPERADMIN_URL=https://admin.localhost:3443
NEXT_PUBLIC_MARKETING_URL=https://www.localhost:3443

# Optional, only during a controlled platform bootstrap. Never expose publicly.
# PLATFORM_BOOTSTRAP_NONCE=provide_via_secret_manager_only

# Credential Vault (AES-256-GCM). Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_32_bytes

# Evolution API (WhatsApp engine, fallback — production uses DB credentials)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=12345

# Cloudflare R2 / S3 Object Storage (Media: audio, images, videos, attachments)
# Set STORAGE_PROVIDER=r2 to activate Cloudflare R2 (or 'local' for local uploads folder)
STORAGE_PROVIDER=local
STORAGE_BUCKET=bipesend-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=replace_with_r2_access_key_id
STORAGE_SECRET_KEY=replace_with_r2_secret_access_key
STORAGE_PUBLIC_URL=https://media.bipesend.com.br
