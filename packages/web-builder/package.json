{
  "name": "@bipesend/web-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "vite --config vite.config.ts",
    "demo:build": "vite build --config vite.config.ts"
  },
  "dependencies": {
    "@bipesend/contracts": "workspace:*",
    "@bipesend/web-builder-core": "workspace:*",
    "@bipesend/web-builder-ui": "workspace:*",
    "@bipesend/web-renderer": "workspace:*",
    "react-hook-form": "^7.87.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "vitest": "5.0.0",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.0.1"
  }
}
