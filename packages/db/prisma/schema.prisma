generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken   String   @unique @map("token_hash")
  userId         String   @map("user_id") @db.Uuid
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  surface        String   @default("tenant") @db.VarChar(50)
  expires        DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String?
  email                String?      @unique
  emailNormalized      String?      @unique @map("email_normalized")
  emailVerified        DateTime?    @map("email_verified")
  image                String?
  password             String?      @map("password_hash")
  companyName          String?      @map("company_name")
  isSuperadmin         Boolean      @default(false) @map("is_superadmin")
  isManagedAccount     Boolean      @default(false) @map("is_managed_account")
  twoFactorEnabled     Boolean      @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?      @map("two_factor_secret")
  twoFactorBackupCodes String[]     @map("two_factor_backup_codes")
  status               String       @default("active") @db.VarChar(50)
  signupOrigin         String?      @map("signup_origin") @db.VarChar(50)
  authVersion          Int          @default(1) @map("auth_version")
  mustChangePassword   Boolean      @default(false) @map("must_change_password")
  passwordChangedAt    DateTime?    @map("password_changed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  accounts             Account[]
  memberships          Membership[]
  sessions             Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String                      @db.VarChar(255)
  slug                        String                      @unique @default(dbgenerated("gen_random_uuid()")) @db.VarChar(100)
  ownerMembershipId           String?                     @map("owner_membership_id") @db.Uuid
  status                      String                      @default("active") @db.VarChar(50)
  authorizationVersion        Int                         @default(1) @map("authorization_version")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @default(now()) @updatedAt @map("updated_at")
  apiKeys                     ApiKey[]
  departments                 Department[]
  invitations                 Invitation[]
  memberships                 Membership[]
  webhookEndpoints            WebhookEndpoint[]
  contacts                    Contact[]
  customFields                CustomField[]
  tags                        Tag[]
  contactTags                 ContactTag[]
  segments                    Segment[]
  importBatches               ContactImportBatch[]
  pipelines                   Pipeline[]
  pipelineStages              PipelineStage[]
  deals                       Deal[]
  dealStageHistories          DealStageHistory[]
  conversations               Conversation[]
  messages                    Message[]
  conversationReadStates      ConversationReadState[]
  conversationStatusHistories ConversationStatusHistory[]

  @@map("tenants")
}

model Membership {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String                      @map("tenant_id") @db.Uuid
  userId                      String                      @map("user_id") @db.Uuid
  role                        String                      @default("member") @db.VarChar(50)
  displayName                 String?                     @map("display_name") @db.VarChar(120)
  relationshipType            String                      @default("team_partner") @map("relationship_type") @db.VarChar(50)
  status                      String                      @default("active") @db.VarChar(50)
  authorizationVersion        Int                         @default(1) @map("authorization_version")
  jobTitle                    String?                     @map("job_title") @db.VarChar(100)
  invitedByMembershipId       String?                     @map("invited_by_membership_id") @db.Uuid
  joinedAt                    DateTime?                   @map("joined_at")
  suspendedAt                 DateTime?                   @map("suspended_at")
  removedAt                   DateTime?                   @map("removed_at")
  statusReason                String?                     @map("status_reason")
  active                      Boolean                     @default(true)
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @default(now()) @updatedAt @map("updated_at")
  departmentId                String?                     @map("department_id") @db.Uuid
  alias                       String?                     @db.VarChar(100)
  department                  Department?                 @relation(fields: [departmentId], references: [id])
  dealsAssigned               Deal[]                      @relation("DealAssignedMembership")
  dealsCreated                Deal[]                      @relation("DealCreatedByMembership")
  dealsUpdated                Deal[]                      @relation("DealUpdatedByMembership")
  dealHistories               DealStageHistory[]
  conversationsAssigned       Conversation[]              @relation("ConversationAssignedMembership")
  conversationsCreated        Conversation[]              @relation("ConversationCreatedByMembership")
  messagesAuthored            Message[]
  conversationReadStates      ConversationReadState[]
  conversationStatusHistories ConversationStatusHistory[]
  tenant                      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

model DisconnectionRequest {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  requestedBy  String   @map("requested_by") @db.Uuid
  approvedBy   String?  @map("approved_by") @db.Uuid
  reason       String
  status       String   @default("PENDING") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("disconnection_requests")
}

model Role {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  departmentId          String?        @map("department_id") @db.Uuid
  key                   String?        @unique @db.VarChar(100)
  name                  String         @db.VarChar(100)
  nameNormalized        String?        @map("name_normalized")
  description           String?        @db.VarChar(500)
  scopeKind             String         @default("TENANT") @map("scope_kind") @db.VarChar(50)
  isBaseRole            Boolean        @default(false) @map("is_base_role")
  status                String         @default("active") @db.VarChar(50)
  policyVersion         Int            @default(1) @map("policy_version")
  createdByMembershipId String?        @map("created_by_membership_id") @db.Uuid
  updatedByMembershipId String?        @map("updated_by_membership_id") @db.Uuid
  archivedAt            DateTime?      @map("archived_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  department            Department?    @relation(fields: [departmentId], references: [id])
  deals                 Deal[]
  Conversation          Conversation[]

  @@map("roles")
}

model Permission {
  id          String  @id @db.VarChar(100)
  description String?

  @@map("permissions")
}

model Department {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  name                  String         @db.VarChar(100)
  nameNormalized        String?        @map("name_normalized")
  description           String?
  status                String         @default("active") @db.VarChar(50)
  leadMembershipId      String?        @map("lead_membership_id") @db.Uuid
  sortOrder             Int?           @map("sort_order")
  createdByMembershipId String?        @map("created_by_membership_id") @db.Uuid
  archivedAt            DateTime?      @map("archived_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships           Membership[]
  roles                 Role[]
  Deal                  Deal[]
  Conversation          Conversation[]

  @@unique([tenantId, name])
  @@map("departments")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.VarChar(100)
  tenantId     String?  @map("tenant_id") @db.Uuid
  scopeType    String   @default("TENANT") @map("scope_type") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Invitation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  email                 String    @db.VarChar(255)
  emailNormalized       String?   @map("email_normalized") @db.VarChar(255)
  name                  String?   @db.VarChar(120)
  role                  String    @db.VarChar(50)
  relationshipType      String    @default("team_partner") @map("relationship_type") @db.VarChar(50)
  status                String    @default("pending") @db.VarChar(50)
  deliveryStatus        String    @default("queued") @map("delivery_status") @db.VarChar(50)
  tokenHash             String    @unique @map("token_hash") @db.VarChar(255)
  challengeId           String?   @map("challenge_id") @db.VarChar(255)
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  accessSnapshotVersion Int       @default(1) @map("access_snapshot_version")
  acceptedByUserId      String?   @map("accepted_by_user_id") @db.Uuid
  acceptedAt            DateTime? @map("accepted_at")
  revokedAt             DateTime? @map("revoked_at")
  lastSentAt            DateTime? @map("last_sent_at")
  sendCount             Int       @default(0) @map("send_count")
  expiresAt             DateTime  @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("invitations")
}

model PermissionDependency {
  permissionId         String @map("permission_id") @db.VarChar(100)
  requiredPermissionId String @map("required_permission_id") @db.VarChar(100)

  @@id([permissionId, requiredPermissionId])
  @@map("permission_dependencies")
}

model MembershipRole {
  tenantId              String    @map("tenant_id") @db.Uuid
  membershipId          String    @map("membership_id") @db.Uuid
  roleId                String    @map("role_id") @db.Uuid
  grantedByMembershipId String?   @map("granted_by_membership_id") @db.Uuid
  grantedAt             DateTime  @default(now()) @map("granted_at")
  expiresAt             DateTime? @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model DepartmentMembership {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  status       String    @default("active") @db.VarChar(50)
  isPrimary    Boolean   @default(false) @map("is_primary")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")
  version      Int       @default(1)

  @@unique([departmentId, membershipId])
  @@map("department_memberships")
}

model DepartmentRoleAssignment {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  departmentId           String    @map("department_id") @db.Uuid
  departmentMembershipId String    @map("department_membership_id") @db.Uuid
  roleId                 String    @map("role_id") @db.Uuid
  grantedByMembershipId  String?   @map("granted_by_membership_id") @db.Uuid
  grantedAt              DateTime  @default(now()) @map("granted_at")
  expiresAt              DateTime? @map("expires_at")
  revokedAt              DateTime? @map("revoked_at")

  @@unique([departmentMembershipId, roleId])
  @@map("department_role_assignments")
}

model MembershipPermissionGrant {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  membershipId          String    @map("membership_id") @db.Uuid
  permissionId          String    @map("permission_id") @db.VarChar(100)
  scopeType             String    @default("TENANT") @map("scope_type") @db.VarChar(50)
  reason                String?
  grantedByMembershipId String?   @map("granted_by_membership_id") @db.Uuid
  grantedAt             DateTime  @default(now()) @map("granted_at")
  expiresAt             DateTime? @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")

  @@map("membership_permission_grants")
}

model UserVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_verifications")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_resets")
}

model PgMigration {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)

  @@map("pgmigrations")
}

model ApiKey {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(100)
  keyHash   String    @unique @map("key_hash") @db.VarChar(255)
  prefix    String    @db.VarChar(50)
  scopes    String[]  @default([])
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model WebhookEndpoint {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  url        String            @db.VarChar(2048)
  secret     String            @db.VarChar(255)
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deliveries WebhookDelivery[]
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId  String          @map("endpoint_id") @db.Uuid
  eventId     String          @map("event_id") @db.VarChar(255)
  payload     Json
  status      String          @db.VarChar(50)
  statusCode  Int?            @map("status_code")
  createdAt   DateTime        @default(now()) @map("created_at")
  completedAt DateTime?       @map("completed_at")
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, eventId])
  @@map("webhook_deliveries")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  targetId  String?  @map("target_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  action    String   @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetId])
  @@index([tenantId])
  @@map("audit_logs")
}

model ErrorReport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  requestId String   @map("request_id") @db.VarChar(100)
  errorCode String   @map("error_code") @db.VarChar(100)
  context   Json?
  status    String   @default("open") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([requestId])
  @@map("error_reports")
}

model CustomField {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  key        String   @db.VarChar(100)
  label      String   @db.VarChar(100)
  type       String   @db.VarChar(50)
  options    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, key])
  @@map("custom_fields")
}

model Contact {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String         @db.VarChar(255)
  email         String?        @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  customFields  Json?          @map("custom_fields")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags          ContactTag[]
  deals         Deal[]
  conversations Conversation[]

  @@map("contacts")
}

model Tag {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  name                  String       @db.VarChar(100)
  nameNormalized        String?      @map("name_normalized")
  colorToken            String?      @map("color_token") @db.VarChar(50)
  status                String       @default("active") @db.VarChar(50)
  version               Int          @default(1)
  createdByMembershipId String?      @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at")
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts              ContactTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model ContactTag {
  tenantId              String   @map("tenant_id") @db.Uuid
  contactId             String   @map("contact_id") @db.Uuid
  tagId                 String   @map("tag_id") @db.Uuid
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Segment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String   @db.VarChar(100)
  description       String?
  filterAst         Json     @map("filter_ast")
  schemaVersion     Int      @default(1) @map("schema_version")
  version           Int      @default(1)
  visibility        String   @default("private") @db.VarChar(50)
  ownerMembershipId String?  @map("owner_membership_id") @db.Uuid
  status            String   @default("active") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("segments")
}

model ContactImportBatch {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  status                String    @db.VarChar(50)
  requestKey            String    @map("request_key") @db.VarChar(255)
  payloadHash           String    @map("payload_hash") @db.VarChar(255)
  mapping               Json?
  parseOptions          Json?     @map("parse_options")
  definitionSnapshot    Json?     @map("definition_snapshot")
  stagedRows            Json?     @map("staged_rows")
  rowIssues             Json?     @map("row_issues")
  selectionHash         String?   @map("selection_hash") @db.VarChar(255)
  confirmationKey       String?   @map("confirmation_key") @db.VarChar(255)
  totalRows             Int       @default(0) @map("total_rows")
  selectedRows          Int       @default(0) @map("selected_rows")
  createdCount          Int       @default(0) @map("created_count")
  skippedCount          Int       @default(0) @map("skipped_count")
  resultReferences      Json?     @map("result_references")
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  expiresAt             DateTime  @map("expires_at")
  committedAt           DateTime? @map("committed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, createdByMembershipId, requestKey])
  @@map("contact_import_batches")
}

model Pipeline {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(100)
  nameNormalized  String   @map("name_normalized") @db.VarChar(100)
  description     String?
  status          String   @default("active") @db.VarChar(50)
  defaultCurrency String   @default("BRL") @map("default_currency") @db.VarChar(3)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([tenantId, name])
  @@map("pipelines")
}

model PipelineStage {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  pipelineId         String    @map("pipeline_id") @db.Uuid
  name               String    @db.VarChar(100)
  position           Int       @default(0)
  colorToken         String?   @map("color_token") @db.VarChar(50)
  category           String    @default("open") @db.VarChar(50)
  requiredFieldRules Json      @map("required_field_rules")
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@map("pipeline_stages")
}

model Deal {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  contactId             String    @map("contact_id") @db.Uuid
  pipelineId            String    @map("pipeline_id") @db.Uuid
  stageId               String    @map("stage_id") @db.Uuid
  title                 String    @db.VarChar(255)
  amount                Decimal   @db.Decimal(15, 2)
  currency              String    @default("BRL") @db.VarChar(3)
  expectedCloseDate     DateTime? @map("expected_close_date")
  closedAt              DateTime? @map("closed_at")
  lostReason            String?   @map("lost_reason") @db.VarChar(1000)
  departmentId          String?   @map("department_id") @db.Uuid
  routingRoleId         String?   @map("routing_role_id") @db.Uuid
  assignedMembershipId  String?   @map("assigned_membership_id") @db.Uuid
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  updatedByMembershipId String    @map("updated_by_membership_id") @db.Uuid
  version               Int       @default(1)
  archivedAt            DateTime? @map("archived_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact             Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline            Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage               PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  department          Department?        @relation(fields: [departmentId], references: [id])
  routingRole         Role?              @relation(fields: [routingRoleId], references: [id])
  assignedMembership  Membership?        @relation("DealAssignedMembership", fields: [assignedMembershipId], references: [id])
  createdByMembership Membership         @relation("DealCreatedByMembership", fields: [createdByMembershipId], references: [id])
  updatedByMembership Membership         @relation("DealUpdatedByMembership", fields: [updatedByMembershipId], references: [id])
  history             DealStageHistory[]

  // RLS / composite FK compliance: ensure relationships stay within the same tenant.
  // Note: Prisma does not easily enforce multi-column cross-table checks natively without compound uniques,
  // but we should at least index these well.
  @@index([tenantId, pipelineId])
  @@index([tenantId, contactId])
  @@map("deals")
}

model DealStageHistory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  dealId            String   @map("deal_id") @db.Uuid
  fromStageId       String?  @map("from_stage_id") @db.Uuid
  toStageId         String   @map("to_stage_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  reason            String?  @db.VarChar(1000)
  occurredAt        DateTime @default(now()) @map("occurred_at")
  version           Int

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal            Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorMembership Membership? @relation(fields: [actorMembershipId], references: [id])

  @@index([dealId])
  @@index([tenantId])
  @@map("deal_stage_history")
}

model Conversation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  contactId             String    @map("contact_id") @db.Uuid
  subject               String?   @db.VarChar(255)
  source                String    @default("internal_crm") @db.VarChar(50)
  channelReference      String?   @map("channel_reference") @db.VarChar(255)
  status                String    @default("open") @db.VarChar(50)
  departmentId          String?   @map("department_id") @db.Uuid
  routingRoleId         String?   @map("routing_role_id") @db.Uuid
  assignedMembershipId  String?   @map("assigned_membership_id") @db.Uuid
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  version               Int       @default(1)
  lastActivityAt        DateTime  @default(now()) @map("last_activity_at")
  closedAt              DateTime? @map("closed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact             Contact                     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  department          Department?                 @relation(fields: [departmentId], references: [id])
  routingRole         Role?                       @relation(fields: [routingRoleId], references: [id])
  assignedMembership  Membership?                 @relation("ConversationAssignedMembership", fields: [assignedMembershipId], references: [id])
  createdByMembership Membership                  @relation("ConversationCreatedByMembership", fields: [createdByMembershipId], references: [id])
  messages            Message[]
  readStates          ConversationReadState[]
  statusHistories     ConversationStatusHistory[]

  @@index([tenantId, contactId])
  @@map("conversations")
}

model Message {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  conversationId          String   @map("conversation_id") @db.Uuid
  sequence                String   @db.VarChar(50)
  kind                    String   @default("internal_note") @db.VarChar(50)
  direction               String   @default("internal") @db.VarChar(50)
  authorMembershipId      String?  @map("author_membership_id") @db.Uuid
  externalSenderReference String?  @map("external_sender_reference") @db.VarChar(255)
  text                    String
  state                   String   @default("saved") @db.VarChar(50)
  clientMessageId         String?  @map("client_message_id") @db.VarChar(255)
  createdAt               DateTime @default(now()) @map("created_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorMembership Membership?  @relation(fields: [authorMembershipId], references: [id])

  @@unique([tenantId, conversationId, authorMembershipId, clientMessageId])
  @@index([tenantId, conversationId])
  @@map("messages")
}

model ConversationReadState {
  tenantId         String   @map("tenant_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  membershipId     String   @map("membership_id") @db.Uuid
  lastReadSequence String   @map("last_read_sequence") @db.VarChar(50)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([tenantId, conversationId, membershipId])
  @@map("conversation_read_states")
}

model ConversationStatusHistory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  fromStatus        String?  @map("from_status") @db.VarChar(50)
  toStatus          String   @map("to_status") @db.VarChar(50)
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  reason            String?  @db.VarChar(1000)
  occurredAt        DateTime @default(now()) @map("occurred_at")
  version           Int

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorMembership Membership?  @relation(fields: [actorMembershipId], references: [id])

  @@index([tenantId, conversationId])
  @@map("conversation_status_history")
}
