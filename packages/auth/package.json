{
  "name": "@bipesend/auth",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@bipesend/db": "workspace:*",
    "argon2": "^0.41.1",
    "next-auth": "beta",
    "otplib": "^12.0.1",
    "@bipesend/contracts": "workspace:*",
    "@bipesend/security": "workspace:*",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.6.2",
    "tsx": "^4.19.4"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./policies": {
      "types": "./dist/policies.d.ts",
      "default": "./dist/policies.js"
    },
