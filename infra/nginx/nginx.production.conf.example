worker_processes auto;

events {
  worker_connections 2048;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  upstream marketing_web { server marketing_web:3002; }
  upstream tenant_web { server tenant_web:3000; }
  upstream superadmin_web { server superadmin_web:3001; }
  upstream api_service { server api:4000; }

  server {
    listen 80;
    server_name bipesend.com.br www.bipesend.com.br app.bipesend.com.br admin.bipesend.com.br api.bipesend.com.br hooks.bipesend.com.br;
    return 308 https://$host$request_uri;
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name bipesend.com.br www.bipesend.com.br;

    ssl_certificate /etc/letsencrypt/live/bipesend.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bipesend.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/deny-sensitive-files.conf;

    location / {
      include /etc/nginx/snippets/proxy-common.conf;
      proxy_pass http://marketing_web;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name app.bipesend.com.br;

    ssl_certificate /etc/letsencrypt/live/bipesend.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bipesend.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/deny-sensitive-files.conf;

    location / {
      include /etc/nginx/snippets/proxy-common.conf;
      proxy_pass http://tenant_web;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name admin.bipesend.com.br;

    ssl_certificate /etc/letsencrypt/live/bipesend.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bipesend.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/deny-sensitive-files.conf;

    location / {
      include /etc/nginx/snippets/proxy-common.conf;
      proxy_pass http://superadmin_web;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name api.bipesend.com.br hooks.bipesend.com.br;

    ssl_certificate /etc/letsencrypt/live/bipesend.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bipesend.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/deny-sensitive-files.conf;

    location / {
      include /etc/nginx/snippets/proxy-common.conf;
      proxy_pass http://api_service;
    }
  }
}
