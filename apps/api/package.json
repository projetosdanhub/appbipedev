{
  "name": "@bipesend/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
