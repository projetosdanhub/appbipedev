{
  "name": "@bipesend/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate": "node-pg-migrate -m src/infra/database/migrations --envPath ../../.env up",
    "admin:bootstrap": "tsx src/modules/14-platform/presentation/cli.ts",
    "test:unit": "node --import tsx --test src/tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test src/tests/tenant.repository.test.ts"
  },
  "dependencies": {
    "@bipesend/auth": "workspace:*",
    "@bipesend/config": "workspace:*",
    "@bipesend/contracts": "workspace:*",
    "@bipesend/security": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "argon2": "^0.45.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "nodemailer": "^10.0.3",
    "pg": "^8.14.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.13",
    "eslint": "^9.39.5",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
