{
  "name": "@bipesend/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate": "node-pg-migrate -m src/infra/database/migrations --envPath ../../.env up",
    "admin:bootstrap": "tsx src/modules/14-platform/presentation/cli.ts",
    "test:unit": "node --import tsx --test src/tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test src/tests/tenant.repository.test.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@bipesend/auth": "workspace:*",
    "@bipesend/config": "workspace:*",
    "@bipesend/contracts": "workspace:*",
    "@bipesend/db": "workspace:*",
    "@bipesend/events": "workspace:*",
    "@bipesend/evolution": "workspace:*",
    "@bipesend/logger": "workspace:*",
    "@bipesend/security": "workspace:*",
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.6",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.6.1",
    "nodemailer": "^10.0.3",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.13",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
